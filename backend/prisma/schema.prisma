// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setor {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  contratos  Contrato[]
  itts       Itt[]
  documentos Documento[]
  usuarios   Usuario[]   @relation("UsuarioSetor")
  dashboards Dashboard[] @relation("DashboardSetor")
  layouts DashboardLayout[]
  indicadores Indicador[] @relation("IndicadorSetor")
  incidentes IncidenteOna[] @relation("IncidenteSetor")
  fechamentosCiclo FechamentoCicloOna[] @relation("FechamentoCicloSetor")
}

model Usuario {
  id      Int      @id @default(autoincrement())
  nome    String
  email   String   @unique
  senha   String   @default("$2b$10$HRQ8qYxTuNqFuHOi1DFKUe6VxXzS/gWXKs4wMRDu/s9wYn0sbYpN2") // mudar123
  perfil  String   @default("GESTOR") // ADMIN, GESTOR, LEITURA
  setores Setor[]  @relation("UsuarioSetor")
}

model Contrato {
  id                   Int               @id @default(autoincrement())
  empresa              String
  setorId              Int
  setor                Setor             @relation(fields: [setorId], references: [id])
  prazo_rescisao_dias  Int?              
  valor                Float?
  valor_tipo           String?           // FIXO, VARIAVEL
  valor_observacao     String?           // "R$ x/turno"
  data_contratacao     DateTime?
  data_vigencia_fim    DateTime?
  renovacao_automatica Boolean           @default(false)
  dias_alerta          Int               @default(30)
  status               String            @default("VIGENTE") // VIGENTE, A_VENCER, VENCIDO, RENOVADO, ENCERRADO
  observacao           String?
  anexos               String?           
  criado_por           String?
  atualizado_em        DateTime          @updatedAt
  criado_em            DateTime          @default(now())
  HistoricoAlerta      HistoricoAlerta[]
  aditivos             Aditivo[]
}

model Aditivo {
  id                 Int      @id @default(autoincrement())
  contratoId         Int
  contrato           Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  descricao          String?
  data_assinatura    DateTime?
  nova_data_vigencia DateTime
  novo_valor         Float?
  anexos             String?
  criado_em          DateTime @default(now())
}

model HistoricoAlerta {
  id           Int      @id @default(autoincrement())
  contratoId   Int
  contrato     Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  data_envio   DateTime @default(now())
  destinatarios String
  status_envio String
  erro         String?
}

model Configuracao {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor String
}

model Itt {
  id                   Int               @id @default(autoincrement())
  titulo               String
  setorId              Int
  setor                Setor             @relation(fields: [setorId], references: [id])
  data_emissao         DateTime?
  data_vigencia_fim    DateTime?
  dias_alerta          Int               @default(30)
  status               String            @default("VIGENTE") // VIGENTE, A_VENCER, VENCIDO, REVISADO, CANCELADO
  observacao           String?
  anexos               String?           
  criado_por           String?
  atualizado_em        DateTime          @updatedAt
  criado_em            DateTime          @default(now())
  HistoricoAlertaItt   HistoricoAlertaItt[]
  revisoes             RevisaoItt[]
}

model RevisaoItt {
  id                 Int      @id @default(autoincrement())
  ittId              Int
  itt                Itt      @relation(fields: [ittId], references: [id], onDelete: Cascade)
  descricao          String?
  nova_data_vigencia DateTime
  anexos             String?
  criado_em          DateTime @default(now())
}

model HistoricoAlertaItt {
  id           Int      @id @default(autoincrement())
  ittId        Int
  itt          Itt      @relation(fields: [ittId], references: [id], onDelete: Cascade)
  data_envio   DateTime @default(now())
  destinatarios String
  status_envio String
  erro         String?
}

model Documento {
  id                   Int               @id @default(autoincrement())
  tipo                 String            @default("CND") // CND, CERTIFICADO, ALVARA, OUTROS
  orgao_emissor        String?           
  titulo               String
  setorId              Int
  setor                Setor             @relation(fields: [setorId], references: [id])
  data_emissao         DateTime?
  data_vigencia_fim    DateTime?
  dias_alerta          Int               @default(30)
  status               String            @default("VIGENTE") // VIGENTE, A_VENCER, VENCIDO, RENOVADO, CANCELADO
  observacao           String?
  anexos               String?           
  criado_por           String?
  atualizado_em        DateTime          @updatedAt
  criado_em            DateTime          @default(now())
  HistoricoAlertaDoc   HistoricoAlertaDocumento[]
  renovacoes           RenovacaoDocumento[]
}

model RenovacaoDocumento {
  id                 Int      @id @default(autoincrement())
  documentoId        Int
  documento          Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  descricao          String?
  nova_data_vigencia DateTime
  anexos             String?
  criado_em          DateTime @default(now())
}

model HistoricoAlertaDocumento {
  id           Int      @id @default(autoincrement())
  documentoId  Int
  documento    Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  data_envio   DateTime @default(now())
  destinatarios String
  status_envio String
  erro         String?
}
  
model ConexaoBanco {
  id        Int      @id @default(autoincrement())
  nome      String   
  host      String   
  porta     Int      @default(3050)
  caminho   String   
  usuario   String
  senha     String   
}

model Indicador {
  id             Int        @id @default(autoincrement())
  codigo         String?
  nome           String
  descricao      String?
  desc_formula   String?
  fonte_referencia String?
  categoria      String?
  subcategoria   String?
  unidade_medida String?
  orientacao     String?
  frequencia     String?
  setorId Int?
  peso           Float?
  ativo          Boolean    @default(true)
  tipo_consulta  String?    @default("SQL")
  conexaoId      Int?
  setor          Setor?     @relation("IndicadorSetor", fields: [setorId], references: [id])
  
  query_sql      String     
  tipo_grafico   String     
  coluna_x       String?    
  coluna_y       String?    
  dias_alerta    Int?       
  ordem          Int?       @default(0)
  tolerancia     Float?     @default(5)
  historico_sql  String?

  // Atributos de Acreditação ONA
  tipo_ona            String?   @default("PROCESSO") // ESTRUTURA, PROCESSO, RESULTADO
  dimensao_qualidade  String?   @default("SEGURANCA") // SEGURANCA, EFETIVIDADE, EFICIENCIA, CENTRADO_NO_PACIENTE, OPORTUNIDADE, EQUIDADE
  protocolo_seguranca String?   @default("NAO_APLICAVEL") // HIGIENE_MAOS, IDENTIFICACAO, MEDICACAO, CIRURGIA_SEGURA, QUEDAS, LESAO_PRESSAO, OUTRO, NAO_APLICAVEL
  versao_ficha        Int?      @default(1)
  revisao_data        DateTime?
  
  dashboards     DashboardIndicador[]
  metas          MetaIndicador[]
  planosAcao     PlanoAcaoIndicador[]
  incidentes     IncidenteOna[]       @relation("IncidenteIndicador")
  cache          CacheIndicador?
}

model CacheIndicador {
  id            Int       @id @default(autoincrement())
  indicadorId   Int       @unique
  indicador     Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  dados_json    String
  duracao_ms    Int?
  atualizado_em DateTime  @default(now())
}

model CategoriaIndicador {
  id             Int                     @id @default(autoincrement())
  nome           String                  @unique
  subcategorias  SubcategoriaIndicador[]
}

model SubcategoriaIndicador {
  id           Int                @id @default(autoincrement())
  nome         String
  categoriaId  Int
  categoria    CategoriaIndicador @relation(fields: [categoriaId], references: [id])
}

model MetaIndicador {
  id                 Int       @id @default(autoincrement())
  indicadorId        Int
  indicador          Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  descricao          String
  valor_alvo         Float
  competencia        String?
  data_limite        DateTime?
  benchmarking       Float?
  benchmarking_fonte String?
}

model PlanoAcaoIndicador {
  id                 Int       @id @default(autoincrement())
  indicadorId        Int
  indicador          Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  competencia        String?
  valor_obtido       Float?
  meta_esperada      Float?
  justificativa      String
  plano_acao         String
  responsavel        String?
  prazo              String?
  status             String    @default("PENDENTE") // PENDENTE, EM_ANDAMENTO, CONCLUIDO
  eficacia           String?   @default("PENDENTE") // PENDENTE, EFICAZ, INEFICAZ
  evidencia_eficacia String?

  // Análise de Causa Raiz ONA (Ishikawa 6M & 5 Porquês)
  causa_raiz_metodo  String?   // ISHIKAWA, CINCO_PORQUES, OUTRO
  ishikawa_6m        String?   // JSON com 6M: metodo, mao_de_obra, material, maquina, meio_ambiente, medida
  cinco_porques      String?   // JSON com array de perguntas/respostas

  // Padrão 5W2H
  what_acao          String?   // O que será feito?
  why_motivo         String?   // Por que será feito?
  where_local        String?   // Onde será feito?
  who_responsavel    String?   // Quem fará?
  when_prazo         String?   // Quando será concluído?
  how_metodo         String?   // Como será feito?
  how_much_custo     String?   // Quanto custará? / Recursos

  // Matriz GUT (Gravidade, Urgência, Tendência)
  nota_g             Int?      @default(3) // 1 a 5
  nota_u             Int?      @default(3) // 1 a 5
  nota_t             Int?      @default(3) // 1 a 5
  score_gut          Int?      @default(27) // G * U * T (1 a 125)

  criado_em          DateTime  @default(now())
}

model Dashboard {
  id          Int                  @id @default(autoincrement())
  nome        String
  setores     Setor[]              @relation("DashboardSetor")
  indicadores DashboardIndicador[]
  layouts     DashboardLayout[]
}

model DashboardIndicador {
  dashboardId  Int
  indicadorId  Int
  pos_x        Int     
  pos_y        Int
  largura      Int
  altura       Int
  dashboard    Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  indicador    Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  @@id([dashboardId, indicadorId])
}


model LogSincronizacao {
  id        Int      @id @default(autoincrement())
  data      DateTime @default(now())
  tipo      String   // AUTOMATICO, MANUAL
  sucesso   Boolean
  detalhes  String?
}

model DashboardLayout {
  id          Int       @id @default(autoincrement())
  dashboardId Int
  setorId     Int?      
  layout_json String    
  
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  setor       Setor?    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  
  @@unique([dashboardId, setorId])
}

model UnidadeMedida {
  id        Int      @id @default(autoincrement())
  nome      String
  simbolo   String   @unique
  criado_em DateTime @default(now())
}

model FrequenciaApuracao {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  criado_em DateTime @default(now())
}

model IncidenteOna {
  id                    Int        @id @default(autoincrement())
  numero_protocolo      String     @unique
  data_incidente        DateTime
  tipo_evento           String     // NEAR_MISS, SEM_DANO, COM_DANO_LEVE, COM_DANO_MODERADO, COM_DANO_GRAVE, SENTINELA
  setorId               Int?
  setor                 Setor?     @relation("IncidenteSetor", fields: [setorId], references: [id])
  indicadorId           Int?
  indicador             Indicador? @relation("IncidenteIndicador", fields: [indicadorId], references: [id])
  protocolo_seguranca   String?    @default("OUTRO") // IDENTIFICACAO, MEDICACAO, CIRURGIA, QUEDA, LESAO_PRESSAO, HIGIENE, OUTRO
  descricao_evento      String
  fatores_contribuintes String?
  acoes_imediatas       String?
  notificador_nome      String?    // Opcional / Sigiloso
  status                String     @default("REGISTRADO") // REGISTRADO, EM_INVESTIGACAO, PLANO_IMPLANTADO, CONCLUIDO
  parecer_conclusivo    String?
  criado_em             DateTime   @default(now())
  atualizado_em         DateTime   @updatedAt
}

model FechamentoCicloOna {
  id                     Int       @id @default(autoincrement())
  setorId                Int?
  setor                  Setor?    @relation("FechamentoCicloSetor", fields: [setorId], references: [id])
  competencia            String    // Ex: "10/2026", "3T/2026"
  data_reuniao           DateTime
  participantes          String?
  pontos_fortes          String?
  oportunidades_melhoria String?
  decisoes_comite        String?
  status                 String    @default("FECHADO") // ABERTO, FECHADO, APROVADO_DIRETORIA
  responsavel_ata        String?
  criado_em              DateTime  @default(now())
  atualizado_em          DateTime  @updatedAt
}
