// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setor {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  contratos  Contrato[]
  itts       Itt[]
  documentos Documento[]
  usuarios   Usuario[]   @relation("UsuarioSetor")
  dashboards Dashboard[] @relation("DashboardSetor")
  indicadores Indicador[] @relation("IndicadorSetor")
}

model Usuario {
  id      Int      @id @default(autoincrement())
  nome    String
  email   String   @unique
  senha   String   @default("$2b$10$HRQ8qYxTuNqFuHOi1DFKUe6VxXzS/gWXKs4wMRDu/s9wYn0sbYpN2") // mudar123
  perfil  String   @default("GESTOR") // ADMIN, GESTOR, LEITURA
  setores Setor[]  @relation("UsuarioSetor")
}

model Contrato {
  id                   Int               @id @default(autoincrement())
  empresa              String
  setorId              Int
  setor                Setor             @relation(fields: [setorId], references: [id])
  prazo_rescisao_dias  Int?              
  valor                Float?
  valor_tipo           String?           // FIXO, VARIAVEL
  valor_observacao     String?           // "R$ x/turno"
  data_contratacao     DateTime?
  data_vigencia_fim    DateTime?
  renovacao_automatica Boolean           @default(false)
  dias_alerta          Int               @default(30)
  status               String            @default("VIGENTE") // VIGENTE, A_VENCER, VENCIDO, RENOVADO, ENCERRADO
  observacao           String?
  anexos               String?           
  criado_por           String?
  atualizado_em        DateTime          @updatedAt
  criado_em            DateTime          @default(now())
  HistoricoAlerta      HistoricoAlerta[]
  aditivos             Aditivo[]
}

model Aditivo {
  id                 Int      @id @default(autoincrement())
  contratoId         Int
  contrato           Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  descricao          String?
  data_assinatura    DateTime?
  nova_data_vigencia DateTime
  novo_valor         Float?
  anexos             String?
  criado_em          DateTime @default(now())
}

model HistoricoAlerta {
  id           Int      @id @default(autoincrement())
  contratoId   Int
  contrato     Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  data_envio   DateTime @default(now())
  destinatarios String
  status_envio String
  erro         String?
}

model Configuracao {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor String
}

model Itt {
  id                   Int               @id @default(autoincrement())
  titulo               String
  setorId              Int
  setor                Setor             @relation(fields: [setorId], references: [id])
  data_emissao         DateTime?
  data_vigencia_fim    DateTime?
  dias_alerta          Int               @default(30)
  status               String            @default("VIGENTE") // VIGENTE, A_VENCER, VENCIDO, REVISADO, CANCELADO
  observacao           String?
  anexos               String?           
  criado_por           String?
  atualizado_em        DateTime          @updatedAt
  criado_em            DateTime          @default(now())
  HistoricoAlertaItt   HistoricoAlertaItt[]
  revisoes             RevisaoItt[]
}

model RevisaoItt {
  id                 Int      @id @default(autoincrement())
  ittId              Int
  itt                Itt      @relation(fields: [ittId], references: [id], onDelete: Cascade)
  descricao          String?
  nova_data_vigencia DateTime
  anexos             String?
  criado_em          DateTime @default(now())
}

model HistoricoAlertaItt {
  id           Int      @id @default(autoincrement())
  ittId        Int
  itt          Itt      @relation(fields: [ittId], references: [id], onDelete: Cascade)
  data_envio   DateTime @default(now())
  destinatarios String
  status_envio String
  erro         String?
}

model Documento {
  id                   Int               @id @default(autoincrement())
  tipo                 String            @default("CND") // CND, CERTIFICADO, ALVARA, OUTROS
  orgao_emissor        String?           
  titulo               String
  setorId              Int
  setor                Setor             @relation(fields: [setorId], references: [id])
  data_emissao         DateTime?
  data_vigencia_fim    DateTime?
  dias_alerta          Int               @default(30)
  status               String            @default("VIGENTE") // VIGENTE, A_VENCER, VENCIDO, RENOVADO, CANCELADO
  observacao           String?
  anexos               String?           
  criado_por           String?
  atualizado_em        DateTime          @updatedAt
  criado_em            DateTime          @default(now())
  HistoricoAlertaDoc   HistoricoAlertaDocumento[]
  renovacoes           RenovacaoDocumento[]
}

model RenovacaoDocumento {
  id                 Int      @id @default(autoincrement())
  documentoId        Int
  documento          Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  descricao          String?
  nova_data_vigencia DateTime
  anexos             String?
  criado_em          DateTime @default(now())
}

model HistoricoAlertaDocumento {
  id           Int      @id @default(autoincrement())
  documentoId  Int
  documento    Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  data_envio   DateTime @default(now())
  destinatarios String
  status_envio String
  erro         String?
}
  
model ConexaoBanco {
  id        Int      @id @default(autoincrement())
  nome      String   
  host      String   
  porta     Int      @default(3050)
  caminho   String   
  usuario   String
  senha     String   
}

model Indicador {
  id             Int        @id @default(autoincrement())
  codigo         String?
  nome           String
  descricao      String?
  desc_formula   String?
  fonte_referencia String?
  categoria      String?
  subcategoria   String?
  unidade_medida String?
  orientacao     String?
  frequencia     String?
  setorId Int?
  peso           Float?
  ativo          Boolean    @default(true)
  tipo_consulta  String?    @default("SQL")
  conexaoId      Int?
  setor          Setor?     @relation("IndicadorSetor", fields: [setorId], references: [id])
  
  query_sql      String     
  tipo_grafico   String     
  coluna_x       String?    
  coluna_y       String?    
  dias_alerta    Int?       
  
  dashboards     DashboardIndicador[]
  metas          MetaIndicador[]
  cache          CacheIndicador?
}

model CacheIndicador {
  id            Int       @id @default(autoincrement())
  indicadorId   Int       @unique
  indicador     Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  dados_json    String
  atualizado_em DateTime  @default(now())
}

model CategoriaIndicador {
  id             Int                     @id @default(autoincrement())
  nome           String                  @unique
  subcategorias  SubcategoriaIndicador[]
}

model SubcategoriaIndicador {
  id           Int                @id @default(autoincrement())
  nome         String
  categoriaId  Int
  categoria    CategoriaIndicador @relation(fields: [categoriaId], references: [id])
}

model MetaIndicador {
  id            Int       @id @default(autoincrement())
  indicadorId   Int
  indicador     Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  descricao     String
  valor_alvo    Float
  data_limite   DateTime?
}

model Dashboard {
  id          Int                  @id @default(autoincrement())
  nome        String
  setores     Setor[]              @relation("DashboardSetor")
  indicadores DashboardIndicador[]
}

model DashboardIndicador {
  dashboardId  Int
  indicadorId  Int
  pos_x        Int     
  pos_y        Int
  largura      Int
  altura       Int
  dashboard    Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  indicador    Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  @@id([dashboardId, indicadorId])
}


model LogSincronizacao {
  id        Int      @id @default(autoincrement())
  data      DateTime @default(now())
  tipo      String   // AUTOMATICO, MANUAL
  sucesso   Boolean
  detalhes  String?
}
